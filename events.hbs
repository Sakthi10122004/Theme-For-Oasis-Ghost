{{!< default}}

<main class="events-page">

    <header class="events-header">
        <h1>Events</h1>
    </header>

    <section class="events-section">
        <h2 class="events-title">Upcoming Events</h2>
        <div id="upcoming-events" class="events-container"></div>
    </section>

    <section class="events-section">
        <h2 class="events-title">Impact We’ve Already Stirred</h2>
        <div id="past-events" class="events-container"></div>
    </section>

    <div id="all-events" style="display:none;">
    {{#get "posts" filter="tag:event" limit="all"}}
        {{#foreach posts}}
            <article class="event-data"
                data-title="{{title}}"
                data-url="{{url}}"
                data-image="{{img_url feature_image}}"
                data-raw="{{excerpt}}">
            </article>
        {{/foreach}}
    {{/get}}
    </div>

</main>


<script>
(function () {
    // Optimization: Store DOM elements once
    const today = new Date();
    today.setHours(0,0,0,0);

    const upcomingBox = document.getElementById("upcoming-events");
    const pastBox = document.getElementById("past-events");
    const events = document.querySelectorAll("#all-events .event-data");

    // Use a DocumentFragment for faster DOM insertion
    const upcomingFragment = document.createDocumentFragment();
    const pastFragment = document.createDocumentFragment();

    events.forEach(event => {

        const raw = event.dataset.raw || "";
        if (!raw.includes("Date:")) return;

        const dateMatch = raw.match(/Date:\s*(\d{2}-\d{2}-\d{4})/);
        const timeMatch = raw.match(/Time:\s*(.+?)(?:\r?\n|$)/);
        const placeMatch = raw.match(/Place:\s*(.+?)(?:\r?\n|$)/);

        if (!dateMatch) return;

        const eventDateStr = dateMatch[1];
        const [dd, mm, yyyy] = eventDateStr.split("-");
        const eventDate = new Date(`${yyyy}-${mm}-${dd}`);
        eventDate.setHours(0,0,0,0);

        const title = event.dataset.title;
        const url = event.dataset.url;
        const image = event.dataset.image || "";
        const time = timeMatch ? timeMatch[1].trim() : "—";
        const place = placeMatch ? placeMatch[1].trim() : "—";

        const isUpcoming = eventDate >= today;

        // The card HTML structure
        const card = document.createElement("article");
        card.className = "event-card"; 

        card.innerHTML = `
            <div class="event-poster">
                <img src="${image}" alt="${title || 'Event Poster'}">
            </div>

            <div class="event-info">
                <h3 class="event-title">${title}</h3>
                <p><strong>Date:</strong> ${eventDateStr}</p>

                ${isUpcoming 
                    ? `<p><strong>Time:</strong> ${time}</p>` 
                    : ``}

                <p><strong>Venue:</strong> ${place}</p>
            </div>

            <div class="event-action">
                <a href="${url}" class="event-btn">View Details</a>
            </div>
        `;

        if (isUpcoming) {
            upcomingFragment.appendChild(card);
        } else {
            pastFragment.appendChild(card);
        }
    });

    upcomingBox.appendChild(upcomingFragment);
    pastBox.appendChild(pastFragment);

    /* EMPTY STATES */
    if (!upcomingBox.children.length) {
        upcomingBox.innerHTML = `<p class="no-events-msg">No Upcoming Events</p>`;
    }

    if (!pastBox.children.length) {
        pastBox.innerHTML = `<p class="no-events-msg">No Past Events Yet</p>`;
    }

})();
</script>