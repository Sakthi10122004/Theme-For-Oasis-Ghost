{
    "name": "oasis-theme",
    "version": "1.0.0",
    "description": "A clean, full-width Ghost theme",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "author": {
        "email": "your-email@example.com",
        "name": "Oasis Theme Developer"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-repo/your-theme.git"
    },
    "devDependencies": {
        "autoprefixer": "10.4.7",
        "gulp": "4.0.2",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "5.1.0"
    },
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip"
    },
    "keywords": [
        "ghost",
        "theme",
        "full-width",
        "minimal"
    ],
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "config": {
        "custom": {
            "color_scheme": {
                "type": "select",
                "options": [
                    "Light",
                    "Dark",
                    "Auto"
                ],
                "default": "Light"
            }
        }
    }
}
