{{!< default}}

<main class="oasis-community redesigned">
  <div class="oasis-container">

    <!-- Redesigned Hero: Full-width image with overlay text and centered cards -->
    <section class="oasis-hero redesigned-hero">
      <div class="hero-overlay"></div>
      <div class="oasis-hero-content">
        <div class="hero-text">
          <h1 class="oasis-title">Join the OASIS Community</h1>
          <p class="oasis-intro">Connect with innovators, nonprofits, and philanthropists driving open-source solutions for social impact.</p>
        </div>
        
        <!-- Hero Image as Background-like with Overlay -->
        <div class="hero-image-container">
         
            <img src="{{asset 'images/community_banner.jpg'}}" alt="OASIS Community" class="hero-image">

        </div>

        <!-- Redesigned Cards: Stacked Vertically for Mobile-First, Side-by-Side on Larger Screens -->
        <div class="oasis-cards-grid redesigned-grid">
          <div class="oasis-card oasis-benefits redesigned-card">
            <h3>Why Join OASIS?</h3>
            <div class="benefits-list redesigned-list">
              <div class="benefit">
                <div class="benefit-icon redesigned-icon">→</div>
                <div>
                  <strong>Tap Into Expertise</strong>
                  <p>Work with leading minds in open-source & social innovation.</p>
                </div>
              </div>
              <div class="benefit">
                <div class="benefit-icon redesigned-icon">→</div>
                <div>
                  <strong>Build Real Connections</strong>
                  <p>Connect with changemakers & technologists.</p>
                </div>
              </div>
              <div class="benefit">
                <div class="benefit-icon redesigned-icon">→</div>
                <div>
                  <strong>Unlock Opportunities</strong>
                  <p>Collaborate on tech-for-good projects.</p>
                </div>
              </div>
              <div class="benefit">
                <div class="benefit-icon redesigned-icon">→</div>
                <div>
                  <strong>Access Shared Resources</strong>
                  <p>Playbooks, case studies & tools.</p>
                </div>
              </div>
              <div class="benefit">
                <div class="benefit-icon redesigned-icon">→</div>
                <div>
                  <strong>Boost Your Visibility</strong>
                  <p>Showcase your work globally.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="oasis-card oasis-join redesigned-card">
            <h3>How to Join?</h3>
            <p>No long forms. No barriers. Just good intent and open collaboration.</p>
            <ol class="join-steps redesigned-steps">
              <li>Read community guidelines</li>
              <li>Click Join</li>
              <li>We'll onboard you</li>
            </ol>
            <a href="#" class="oasis-btn oasis-btn-primary redesigned-btn">Join Now</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Redesigned Who Can Join: 3-Column Grid with Hover Effects -->
    <section class="oasis-who redesigned-who">
      <h2 class="oasis-subtitle">Who Can Join?</h2>
      <p class="oasis-lead">If you're a nonprofit struggling with tech or a techie who wants to contribute for impact — this is where both sides meet.</p>
      <div class="oasis-grid-3 redesigned-grid">
        <div class="oasis-category redesigned-category">
          <div class="category-icon redesigned-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 2H6C4.9 2 4.01 2.9 4.01 4L4 20C4 21.1 4.89 22 5.99 22H18C19.1 22 20 21.1 20 20V8L14 2ZM16 18H8V16H16V18ZM16 14H8V12H16V14ZM12 10H8V8H12V10Z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Tech Volunteers & Innovators</h3>
          <p>Developers, students & firms building open-source tools for social good.</p>
        </div>
        <div class="oasis-category redesigned-category">
          <div class="category-icon redesigned-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L13.09 8.26L20 9L13.09 9.74L12 16L10.91 9.74L4 9L10.91 8.26L12 2Z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Social Sector Organisations</h3>
          <p>NGOs adopting scalable open-source tech.</p>
        </div>
        <div class="oasis-category redesigned-category">
          <div class="category-icon redesigned-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11.8 10.9C9.53 10.31 8.8 9.7 8.8 8.75C8.8 7.66 9.81 6.9 11.7 6.9C13.4 6.9 14.3 7.5 14.3 8.19C14.3 8.57 14.1 8.93 13.75 9.07C13.29 9.25 12.74 9.54 11.8 10.9ZM11.7 2C8.73 2 6.3 3.46 6.3 6.3C6.3 9.5 9.7 10.74 11.7 11.74C13.7 10.74 17.1 9.5 17.1 6.3C17.1 3.46 14.67 2 11.7 2ZM11.7 12.5C10.33 12.5 9.3 13.53 9.3 14.9V16.5H14.1V14.9C14.1 13.53 13.07 12.5 11.7 12.5Z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Philanthropic Institutions</h3>
          <p>Funders enabling sustainable tech capacity.</p>
        </div>
      </div>
    </section>

    <!-- Testimonials: Enhanced Swiper with Red Accents -->
  <section class="oasis-testimonials redesigned-testimonials">
  <h2 class="oasis-subtitle">What People Say</h2>

  <div class="testimonials-grid-3">
    {{#get "posts" filter="tag:people-say" order="published_at desc" limit="3"}}
      {{#foreach posts}}
      <blockquote class="oasis-quote redesigned-quote">
        <div class="stars">★★★★★</div>

        {{#if custom_excerpt}}
          <p>"{{custom_excerpt}}"</p>
        {{else}}
          <p>"{{excerpt words="25"}}"</p>
        {{/if}}

        <cite>— {{title}}</cite>
      </blockquote>
      {{/foreach}}
    {{/get}}
  </div>

  <div class="testimonials-readmore">
    <a href="/tag/people-say/" class="oasis-btn redesigned-btn readmore-btn">
      Read more →
    </a>
  </div>
</section>



    <script>
      var testimonialSwiper = new Swiper(".oasis-swiper", {
        loop: true,
        autoplay: { delay: 4000, disableOnInteraction: false },
        speed: 600,
        pagination: { 
          el: ".swiper-pagination", 
          clickable: true,
          dynamicBullets: true 
        },
        slidesPerView: 1,
        spaceBetween: 30,
        breakpoints: {
          768: { slidesPerView: 2 },
          1024: { slidesPerView: 3 }
        }
      });
    </script>

    <!-- Partners: Smooth Marquee with Red Borders -->
    <section class="oasis-partners-section redesigned-partners">
      <h2 class="oasis-subtitle">Our NGO Partners</h2>

      {{#get "posts" filter="tag:ngo" limit="20" include="feature_image"}}

      <div class="partners-marquee redesigned-marquee">
        <div class="partners-track">
          {{#foreach posts}}
          <a href="{{url}}" class="partner-logo redesigned-logo" title="{{title}}">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
            {{else}}
              <span class="partner-text">{{title}}</span>
            {{/if}}
          </a>
          {{/foreach}}

          {{!-- Duplicate for seamless loop --}}
          {{#foreach posts}}
          <a href="{{url}}" class="partner-logo redesigned-logo" title="{{title}}">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
            {{else}}
              <span class="partner-text">{{title}}</span>
            {{/if}}
          </a>
          {{/foreach}}
        </div>
      </div>

      {{/get}}
    </section>

    <!-- Final CTA: Bold Red Button with White Background -->
    <section class="oasis-cta redesigned-cta">
      <div class="cta-content">
        <h2>Ready to Make an Impact?</h2>
        <p>Join thousands of innovators working together for social good.</p>
        <a href="#" class="oasis-btn oasis-btn-secondary redesigned-cta-btn">Join the Community</a>
      </div>
    </section>

  </div>
</main>

