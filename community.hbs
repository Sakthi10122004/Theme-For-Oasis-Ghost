{{!< default}}
<main class="oasis-community">
    <section class="hero-section">
        <div class="container">
            <div class="hero-grid">
                <div class="hero-content">
                    <h1 class="hero-title">Join the <span class="highlight">OASIS</span> Community</h1>
                    <p class="hero-text">Connect with innovators, nonprofits, and philanthropists driving open-source solutions for social impact.</p>
                    <a href="#/portal/signup" class="btn-primary">Join Now</a>
                </div>
                <div class="hero-visual">
                    <img src="{{asset 'images/community_banner.webp'}}" alt="OASIS Community" class="hero-img" loading="lazy" width="600" height="400">
                </div>
            </div>
        </div>
    </section>

    <section class="who-section">
        <div class="container">
            <h2 class="section-title">Who Can Join?</h2>
            <p class="section-lead">For nonprofits tired of wrestling with their tech, and for techies who want to do more than just ship code. OASIS is where both sides finally meet.</p>
            <div class="category-grid">
                <div class="category-card">
                    <h3>Tech Volunteers & Innovators</h3>
                    <p>Build and support open-source solutions that help nonprofits scale their impact.</p>
                </div>
                <div class="category-card">
                    <h3>Social Sector Organisations</h3>
                    <p>NGOs and nonprofits ready to embrace open-source systems to scale their impact.</p>
                </div>
                <div class="category-card">
                    <h3>Philanthropic Institutions</h3>
                    <p>Foundations seeking scalable tech capacity for their portfolios or initiatives.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="benefits-section">
        <div class="container">
            <div class="benefits-grid">
                <div class="benefit-card">
                    <h3>Why Join as an NPO?</h3>
                    <ul class="benefit-list">
                        <li><strong>Tap Into Expertise:</strong> Connect with open-source experts who understand nonprofit realities.</li>
                        <li><strong>Build Real Connections:</strong> Work with peers, technologists, and funders committed to impact.</li>
                        <li><strong>Unlock Solutions:</strong> Turn tech challenges into sustainable open-source tools.</li>
                        <li><strong>Access Resources:</strong> Use playbooks and case studies to grow your digital confidence.</li>
                        <li><strong>Increase Visibility:</strong> Share your work and inspire other nonprofits.</li>
                    </ul>
                </div>
                <div class="benefit-card accent-card">
                    <h3>Why Join as a Tech Expert?</h3>
                    <ul class="benefit-list">
                        <li><strong>Purpose-Driven Partners:</strong> Connect with nonprofits seeking open-source expertise.</li>
                        <li><strong>Build Relationships:</strong> Collaborate with sector leaders and funders.</li>
                        <li><strong>New Opportunities:</strong> Engage in pilots, co-development, and support projects.</li>
                        <li><strong>Sector Insight:</strong> Use shared research to design solutions nonprofits need.</li>
                        <li><strong>Grow Credibility:</strong> Showcase your impact in the social sector.</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="join-section">
        <div class="container">
            <div class="join-grid">
                <div class="join-card">
                    <h3>How to Join?</h3>
                    <p>No long forms. No barriers. Just good intent and open collaboration.</p>
                    <ol class="join-steps">
                        <li><a href="/community-guidelines">Read the community guidelines</a></li>
                        <li>Click Join below</li>
                        <li>We'll onboard you quickly</li>
                    </ol>
                </div>
                <div class="join-card cta-card">
                    <h3>Ready to Join?</h3>
                    <p>Become part of our growing community of changemakers.</p>
                    <a href="#/portal/signup" class="btn-primary btn-large">Join Now</a>
                </div>
            </div>
        </div>
    </section>

    <section class="testimonials-section">
        <div class="container">
            <h2 class="section-title">What The Community Says</h2>
            <div class="testimonial-columns">
                <div class="testimonial-col">
                    <h3 class="testimonial-heading">NPOs</h3>
                    <div class="testimonial-slider" data-slider>
                        <div class="testimonial-track" data-slider-track>
                            {{#get "posts" filter="tag:npo-says" order="published_at desc" limit="5"}}
                                {{#foreach posts}}
                                    <div class="testimonial-item" data-slider-slide>
                                        <blockquote>
                                            <p>"{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="7"}}{{/if}}"</p>
                                            <cite>{{title}}</cite>
                                        </blockquote>
                                    </div>
                                {{/foreach}}
                            {{/get}}
                        </div>
                    </div>
                    <a href="/tag/npo-says/" class="btn-secondary">Read More</a>
                </div>
                <div class="testimonial-col">
                    <h3 class="testimonial-heading">Tech Experts</h3>
                    <div class="testimonial-slider" data-slider>
                        <div class="testimonial-track" data-slider-track>
                            {{#get "posts" filter="tag:tech-experts-says" order="published_at desc" limit="5"}}
                                {{#foreach posts}}
                                    <div class="testimonial-item" data-slider-slide>
                                        <blockquote>
                                            <p>"{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="7"}}{{/if}}"</p>
                                            <cite>{{title}}</cite>
                                        </blockquote>
                                    </div>
                                {{/foreach}}
                            {{/get}}
                        </div>
                    </div>
                    <a href="/tag/tech-experts-says/" class="btn-secondary">Read More</a>
                </div>
            </div>
        </div>
    </section>

    <section class="partners-section">
        <div class="container">
            <h2 class="section-title">Our NPO Partners</h2>
            <div class="partners-marquee">
                <div class="partners-track">
                    {{#get "posts" filter="tag:npo" limit="12" include="feature_image"}}
                        {{#foreach posts}}
                            <a href="{{url}}" class="partner-item" title="{{title}}">
                                {{#if feature_image}}
                                    <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
                                {{else}}
                                    <span>{{title}}</span>
                                {{/if}}
                            </a>
                        {{/foreach}}
                        {{#foreach posts}}
                            <a href="{{url}}" class="partner-item" title="{{title}}">
                                {{#if feature_image}}
                                    <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
                                {{else}}
                                    <span>{{title}}</span>
                                {{/if}}
                            </a>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>
            <a href="/tag/npo" class="btn-secondary">See All Partners</a>
        </div>
    </section>

    <section class="final-cta">
        <div class="container">
            <div class="cta-content">
                <h2>Ready to Make an Impact?</h2>
                <p>Join thousands of innovators working together for social good through open-source collaboration.</p>
                <a href="#/portal/signup" class="btn-primary btn-large">Join the Community Today</a>
            </div>
        </div>
    </section>
</main>
<script>
    // COMMUNITY PAGE JS
  // ================================
  //      JS FOR SLIDER
  // ================================ 
  document.addEventListener('DOMContentLoaded', function () {
    const sliders = document.querySelectorAll('[data-slider]');
    sliders.forEach(function (slider) {
      const track = slider.querySelector('[data-slider-track]');
      const slides = Array.from(slider.querySelectorAll('[data-slider-slide]'));
      if (!track || slides.length <= 1) return;
      let currentIndex = 0;
      const totalSlides = slides.length;
      let autoTimer = null;
      function updateUI() {
        track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
      }
      function nextSlide() {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateUI();
      }
      function startAuto() {
        if (autoTimer) clearInterval(autoTimer);
        autoTimer = setInterval(nextSlide, 5000);
      }
      function stopAuto() {
        if (autoTimer) clearInterval(autoTimer);
      }
      updateUI();
      startAuto();
      slider.addEventListener('mouseenter', stopAuto);
      slider.addEventListener('mouseleave', startAuto);
      let startX;
      slider.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        stopAuto();
      });
      slider.addEventListener('touchend', function (e) {
        const endX = e.changedTouches[0].clientX;
        if (startX - endX > 50) nextSlide();
        else if (endX - startX > 50) {
          currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
          updateUI();
        }
        startAuto();
      });
    });
  });
</script>