{{!< default}}

<main class="oasis-community">
  <div class="oasis-container">

    <!-- Hero / Why Join -->
    <section class="oasis-hero">
      <div class="oasis-hero-content">
        <h1 class="oasis-title">Join the OASIS Community</h1>
        <p class="oasis-intro">Connect with innovators, nonprofits, and philanthropists driving open-source solutions for social impact.</p>

        <div class="oasis-hero-grid">
          <div class="oasis-hero-cards">
            <div class="oasis-card oasis-benefits">
              <h3>Why Join OASIS?</h3>
              <div class="benefits-list">
                <div class="benefit">
                  <div class="benefit-dot"></div>
                  <div>
                    <strong>Tap Into Expertise</strong>
                    <p>Work with leading minds in open-source & social innovation.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-dot"></div>
                  <div>
                    <strong>Build Real Connections</strong>
                    <p>Connect with changemakers & technologists.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-dot"></div>
                  <div>
                    <strong>Unlock Opportunities</strong>
                    <p>Collaborate on tech-for-good projects.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-dot"></div>
                  <div>
                    <strong>Access Shared Resources</strong>
                    <p>Playbooks, case studies & tools.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-dot"></div>
                  <div>
                    <strong>Boost Your Visibility</strong>
                    <p>Showcase your work globally.</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="oasis-card oasis-join">
              <h3>How to Join?</h3>
              <p>No long forms. No barriers. Just good intent and open collaboration.</p>
              <ol class="join-steps">
                <li>Read community guidelines</li>
                <li>Click Join</li>
                <li>We’ll onboard you</li>
              </ol>
              <a href="#" class="oasis-btn oasis-btn-primary">Join Now</a>
            </div>
          </div>

          <div class="oasis-hero-image">
            <div class="hero-image-container">
              <img src="/content/images/2025/11/4.png" alt="OASIS Community Collaboration" class="hero-image">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Can Join -->
    <section class="oasis-who">
      <h2 class="oasis-subtitle">Who Can Join?</h2>
      <p class="oasis-lead">If you're a nonprofit struggling with tech or a techie who wants to contribute for impact — this is where both sides meet.</p>
      <div class="oasis-grid-3">
        <div class="oasis-category">
          <div class="category-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 2H6C4.9 2 4.01 2.9 4.01 4L4 20C4 21.1 4.89 22 5.99 22H18C19.1 22 20 21.1 20 20V8L14 2ZM16 18H8V16H16V18ZM16 14H8V12H16V14ZM12 10H8V8H12V10Z" fill="white"/>
            </svg>
          </div>
          <h3>Tech Volunteers & Innovators</h3>
          <p>Developers, students & firms building open-source tools for social good.</p>
        </div>
        <div class="oasis-category">
          <div class="category-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L13.09 8.26L20 9L13.09 9.74L12 16L10.91 9.74L4 9L10.91 8.26L12 2Z" fill="white"/>
            </svg>
          </div>
          <h3>Social Sector Organisations</h3>
          <p>NGOs adopting scalable open-source tech.</p>
        </div>
        <div class="oasis-category">
          <div class="category-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11.8 10.9C9.53 10.31 8.8 9.7 8.8 8.75C8.8 7.66 9.81 6.9 11.7 6.9C13.4 6.9 14.3 7.5 14.3 8.19C14.3 8.57 14.1 8.93 13.75 9.07C13.29 9.25 12.74 9.54 11.8 10.9ZM11.7 2C8.73 2 6.3 3.46 6.3 6.3C6.3 9.5 9.7 10.74 11.7 11.74C13.7 10.74 17.1 9.5 17.1 6.3C17.1 3.46 14.67 2 11.7 2ZM11.7 12.5C10.33 12.5 9.3 13.53 9.3 14.9V16.5H14.1V14.9C14.1 13.53 13.07 12.5 11.7 12.5Z" fill="white"/>
            </svg>
          </div>
          <h3>Philanthropic Institutions</h3>
          <p>Funders enabling sustainable tech capacity.</p>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="oasis-testimonials">
      <h2 class="oasis-subtitle">What People Say</h2>

      <div class="swiper oasis-swiper">
        <div class="swiper-wrapper">

          {{#get "posts" filter="tag:people-say" limit="10"}}
            {{#foreach posts}}
            <div class="swiper-slide">
              <blockquote class="oasis-quote">
                <div class="stars">★★★★★</div>

                {{#if custom_excerpt}}
                  <p>"{{custom_excerpt}}"</p>
                {{else}}
                  <p>"{{excerpt words="25"}}"</p>
                {{/if}}

                <cite>— {{title}}</cite>
              </blockquote>
            </div>
            {{/foreach}}
          {{/get}}

        </div>

        <!-- Dots Pagination -->
        <div class="swiper-pagination"></div>
      </div>
    </section>

    <script>
      var testimonialSwiper = new Swiper(".oasis-swiper", {
        loop: true,
        autoplay: { delay: 3000, disableOnInteraction: false },
        speed: 650,
        pagination: { el: ".swiper-pagination", clickable: true },
        slidesPerView: 1,
        spaceBetween: 24,
        breakpoints: {
          700: { slidesPerView: 2 },
          1100: { slidesPerView: 3 }
        }
      });
    </script>

    <!-- Partners -->
    <section class="oasis-partners-section">
      <h2 class="oasis-subtitle">Our NGO Partners</h2>

      {{#get "posts" filter="tag:ngo" limit="20" include="feature_image"}}

      <div class="partners-marquee">
        <div class="partners-track">
          {{#foreach posts}}
          <a href="{{url}}" class="partner-logo" title="{{title}}">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="s"}}" alt="{{title}}">
            {{else}}
              <span class="partner-text">{{title}}</span>
            {{/if}}
          </a>
          {{/foreach}}

          {{!-- Duplicate logos once to make infinite scroll seamless --}}
          {{#foreach posts}}
          <a href="{{url}}" class="partner-logo" title="{{title}}">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="s"}}" alt="{{title}}">
            {{else}}
              <span class="partner-text">{{title}}</span>
            {{/if}}
          </a>
          {{/foreach}}
        </div>
      </div>

      {{/get}}
    </section>

    <!-- Final CTA -->
    <section class="oasis-cta">
      <div class="cta-content">
        <h2>Ready to Make an Impact?</h2>
        <p>Join thousands of innovators working together for social good.</p>
        <a href="#" class="oasis-btn oasis-btn-secondary">Join the Community</a>
      </div>
    </section>

  </div>
</main>
