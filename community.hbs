{{!< default}}
<main class="oasis-community-page">
    <section class="oasis-hero">
        <div class="oasis-container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1 class="oasis-title">
                        Join the <span class="highlight">OASIS</span> Community
                    </h1>
                    <p class="oasis-intro">
                        Connect with innovators, nonprofits, and philanthropists driving **open-source solutions** for social impact.
                    </p>
                    <a href="#/portal/signup" class="oasis-btn primary-btn">Join Now</a>
                </div>
                <div class="hero-image-container">
                    <img src="{{asset 'images/community_banner.webp'}}" alt="OASIS Community Collaboration" class="hero-image" loading="lazy" width="600" height="400">
                </div>
            </div>
        </div>
    </section>

    <section class="oasis-who">
        <div class="oasis-container">
            <h2 class="oasis-subtitle">Who Can Join?</h2>
            <p class="oasis-lead">
                For nonprofits tired of wrestling with their tech, and for techies who want to do more than just ship code. OASIS is the place where both sides finally meet.
            </p>
            <div class="oasis-grid-3">
                <div class="oasis-category">
                    <div class="category-icon icon-tech"></div>
                    <h3>Tech Volunteers & Innovators</h3>
                    <p>From solo developers to tech firms, this community builds and supports open-source solutions that help nonprofits scale their impact.</p>
                </div>
                <div class="oasis-category">
                    <div class="category-icon icon-npo"></div>
                    <h3>Social Sector Organisations</h3>
                    <p>NGOs and nonprofits ready to embrace open-source systems to scale their impact and efficiency.</p>
                </div>
                <div class="oasis-category">
                    <div class="category-icon icon-funder"></div>
                    <h3>Philanthropic Institutions</h3>
                    <p>Foundations or grant-makers seeking scalable tech capacity for their portfolios or initiatives.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="oasis-benefits">
        <div class="oasis-container">
            <div class="benefits-grid">
                <div class="oasis-card benefits-card">
                    <h3>Why Should an NPO Join OASIS?</h3>
                    <ul class="benefits-list">
                        <li>
                            <strong>Tap Into Expertise:</strong> Connect with open-source experts who understand nonprofit realities.
                        </li>
                        <li>
                            <strong>Build Real Connections:</strong> Work with peers, technologists, and funders committed to long-term impact.
                        </li>
                        <li>
                            <strong>Unlock Solutions You Can Own:</strong> Turn tech challenges into sustainable open-source tools.
                        </li>
                        <li>
                            <strong>Access Practical Resources:</strong> Use playbooks and case studies to grow your digital confidence.
                        </li>
                        <li>
                            <strong>Increase Your Visibility:</strong> Share your work & inspire other nonprofits on similar journeys.
                        </li>
                    </ul>
                </div>

                <div class="oasis-card benefits-card accent-card">
                    <h3>Why Should a Tech Expert Join OASIS?</h3>
                    <ul class="benefits-list">
                        <li>
                            <strong>Reach Purpose-Driven Partners:</strong> Connect with nonprofits seeking mission-aligned, open-source expertise.
                        </li>
                        <li>
                            <strong>Build Lasting Relationships:</strong> Collaborate with sector leaders, implementers, and funders.
                        </li>
                        <li>
                            <strong>Access New Opportunities:</strong> Engage in pilots, co-development, and long-term support projects.
                        </li>
                        <li>
                            <strong>Gain Sector Insight:</strong> Use shared research and playbooks to design solutions nonprofits truly need.
                        </li>
                        <li>
                            <strong>Grow Your Credibility:</strong> Showcase your impact and strengthen your reputation in the social sector.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="oasis-join-cta">
        <div class="oasis-container">
             <div class="join-grid">
                <div class="oasis-card how-card">
                    <h3>How to Join?</h3>
                    <p>No long forms. No barriers. Just good intent and open collaboration.</p>
                    <ol class="join-steps">
                        <li>
                            <a href="/community-guidelines">Read the community guidelines here before you join.</a>
                        </li>
                        <li>
                            <span>Click Join below</span>
                        </li>
                        <li>
                            <span>We'll onboard you quickly</span>
                        </li>
                    </ol>
                </div>

                <div class="oasis-card ready-section accent-cta">
                    <h3>Ready to Join?</h3>
                    <p>Become part of our growing community of changemakers.</p>
                    <a href="#/portal/signup" class="oasis-btn primary-btn large-btn">Join Now</a>
                </div>
            </div>
        </div>
    </section>

    <section class="oasis-testimonials">
        <div class="oasis-container">
            <h2 class="oasis-subtitle">What The OASIS Community Has To Say</h2>
            <div class="testimonials-two-column">
                <div class="testimonial-column">
                    <h3 class="testimonial-subheading">NPOs</h3>
                    <div class="testimonial-slider" data-slider>
                        <div class="testimonial-track" data-slider-track>
                            {{#get "posts" filter="tag:npo-says" order="published_at desc" limit="5"}}
                                {{#foreach posts}}
                                    <div class="testimonial-slide" data-slider-slide>
                                        <blockquote class="oasis-quote">
                                            <div class="stars">★★★★★</div>
                                            <p>"{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="15"}}{{/if}}"</p>
                                            <cite>— {{title}}</cite>
                                        </blockquote>
                                    </div>
                                {{/foreach}}
                            {{/get}}
                        </div>
                    </div>
                    <a href="/tag/npo-says/" class="secondary-btn small-btn">Read More NPO Stories</a>
                </div>

                <div class="testimonial-column">
                    <h3 class="testimonial-subheading">Tech Experts</h3>
                    <div class="testimonial-slider" data-slider>
                        <div class="testimonial-track" data-slider-track>
                            {{#get "posts" filter="tag:tech-experts-says" order="published_at desc" limit="5"}}
                                {{#foreach posts}}
                                    <div class="testimonial-slide" data-slider-slide>
                                        <blockquote class="oasis-quote">
                                            <div class="stars">★★★★★</div>
                                            <p>"{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="15"}}{{/if}}"</p>
                                            <cite>— {{title}}</cite>
                                        </blockquote>
                                    </div>
                                {{/foreach}}
                            {{/get}}
                        </div>
                    </div>
                    <a href="/tag/tech-experts-says/" class="secondary-btn small-btn">Read More Tech Expert Stories</a>
                </div>
            </div>
        </div>
    </section>

    <section class="oasis-partners">
        <div class="oasis-container">
            <h2 class="oasis-subtitle">Our NPO Partners</h2>
            <div class="partners-marquee">
                <div class="partners-track">
                    {{#get "posts" filter="tag:npo" limit="12" include="feature_image"}}
                        {{#foreach posts}}
                            <a href="{{url}}" class="partner-logo" title="{{title}}">
                                {{#if feature_image}}
                                    <img src="{{img_url feature_image size="s"}}" alt="{{title}} logo" loading="lazy">
                                {{else}}
                                    <span class="partner-text">{{title}}</span>
                                {{/if}}
                            </a>
                        {{/foreach}}
                        {{#foreach posts}}
                            <a href="{{url}}" class="partner-logo" title="{{title}}">
                                {{#if feature_image}}
                                    <img src="{{img_url feature_image size="s"}}" alt="{{title}} logo" loading="lazy">
                                {{else}}
                                    <span class="partner-text">{{title}}</span>
                                {{/if}}
                            </a>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>
            <a href="/tag/npo" class="secondary-btn small-btn">See All Partners</a>
        </div>
    </section>

    <section class="oasis-cta">
        <div class="oasis-container">
            <div class="cta-content">
                <h2>Ready to Make an Impact?</h2>
                <p>Join thousands of innovators working together for social good through open-source collaboration.</p>
                <a href="#/portal/signup" class="oasis-btn primary-btn large-btn">Join the Community Today</a>
            </div>
        </div>
    </section>
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const sliders = document.querySelectorAll('[data-slider]');

    sliders.forEach(function (slider) {
        const track = slider.querySelector('[data-slider-track]');
        const slides = Array.from(slider.querySelectorAll('[data-slider-slide]'));
        
        if (!track || slides.length <= 1) return;

        let currentIndex = 0;
        const totalSlides = slides.length;
        const AUTO_DELAY = 5000;
        let autoTimer = null;

        function updateUI() {
            track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
        }

        function goToSlide(index) {
            currentIndex = (index + totalSlides) % totalSlides;
            updateUI();
        }

        function nextSlide() {
            goToSlide(currentIndex + 1);
        }

        function startAuto() {
            stopAuto();
            autoTimer = setInterval(nextSlide, AUTO_DELAY);
        }

        function stopAuto() {
            if (autoTimer) {
                clearInterval(autoTimer);
                autoTimer = null;
            }
        }

        // Initialize
        updateUI();
        startAuto();

        // Pause on hover
        slider.addEventListener('mouseenter', stopAuto);
        slider.addEventListener('mouseleave', startAuto);

        // Add touch support
        let startX;
        slider.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            stopAuto();
        });
        slider.addEventListener('touchend', (e) => {
            const endX = e.changedTouches[0].clientX;
            const threshold = 50;

            if (startX - endX > threshold) {
                nextSlide();
            } else if (endX - startX > threshold) {
                goToSlide(currentIndex - 1);
            }
            startAuto();
        });
    });
});
</script>