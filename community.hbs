{{!< default}}

<main class="oasis-community redesigned">
  <div class="oasis-container">

    <!-- Hero Section -->
    <section class="oasis-hero redesigned-hero">
      <div class="hero-overlay"></div>
      <div class="oasis-hero-content">
        <div class="hero-text">
          <h1 class="oasis-title">
            Join the <span class="highlight">OASIS</span> Community
          </h1>
          <p class="oasis-intro">
            Connect with innovators, nonprofits, and philanthropists driving open-source solutions for social impact.
          </p>
        </div>
        
        <div class="hero-image-container">
          <img src="{{asset 'images/community_banner.jpg'}}" alt="OASIS Community Collaboration" class="hero-image">
        </div>
      </div>
    </section>

    <!-- Who Can Join Section -->
    <section class="oasis-who redesigned-who">
      <div class="section-container">
        <h2 class="oasis-subtitle">Who Can Join?</h2>
        <p class="oasis-lead">
          For nonprofits tired of wrestling with their tech, and for techies who want to do more than just ship code. OASIS is the place where both sides finally meet.
        </p>
        <div class="oasis-grid-3 redesigned-grid">
          <div class="oasis-category redesigned-category">
            <div class="category-icon redesigned-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14 2H6C4.9 2 4.01 2.9 4.01 4L4 20C4 21.1 4.89 22 5.99 22H18C19.1 22 20 21.1 20 20V8L14 2ZM16 18H8V16H16V18ZM16 14H8V12H16V14ZM12 10H8V8H12V10Z" fill="currentColor"/>
              </svg>
            </div>
            <h3>Tech Volunteers & Innovators</h3>
            <p>From solo developers to tech firms, this community builds and supports open-source solutions that help nonprofits scale their impact.</p>
          </div>
          
          <div class="oasis-category redesigned-category">
            <div class="category-icon redesigned-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L13.09 8.26L20 9L13.09 9.74L12 16L10.91 9.74L4 9L10.91 8.26L12 2Z" fill="currentColor"/>
              </svg>
            </div>
            <h3>Social Sector Organisations</h3>
            <p>NGOs and nonprofits ready to embrace open-source systems to scale their impact.</p>
          </div>
          
          <div class="oasis-category redesigned-category">
            <div class="category-icon redesigned-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11.8 10.9C9.53 10.31 8.8 9.7 8.8 8.75C8.8 7.66 9.81 6.9 11.7 6.9C13.4 6.9 14.3 7.5 14.3 8.19C14.3 8.57 14.1 8.93 13.75 9.07C13.29 9.25 12.74 9.54 11.8 10.9ZM11.7 2C8.73 2 6.3 3.46 6.3 6.3C6.3 9.5 9.7 10.74 11.7 11.74C13.7 10.74 17.1 9.5 17.1 6.3C17.1 3.46 14.67 2 11.7 2ZM11.7 12.5C10.33 12.5 9.3 13.53 9.3 14.9V16.5H14.1V14.9C14.1 13.53 13.07 12.5 11.7 12.5Z" fill="currentColor"/>
              </svg>
            </div>
            <h3>Philanthropic Institutions</h3>
            <p>Foundations or grant-makers seeking scalable tech capacity for their portfolios.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits & Join Section -->
    <section class="oasis-benefits-join">
      <div class="section-container">
        <div class="benefits-join-grid">
          
          <!-- Benefits Side by Side -->
          <div class="benefits-side-by-side">
            <!-- NPO Benefits -->
            <div class="oasis-card redesigned-card benefits-card">
              <h3>Why Should an NPO Join OASIS?</h3>
              <div class="benefits-list redesigned-list">
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Tap Into Expertise</strong>
                    <p>Connect with open-source experts who understand nonprofit realities.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Build Real Connections</strong>
                    <p>Work with peers, technologists, and funders committed to long-term impact.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Unlock Solutions You Can Own</strong>
                    <p>Turn tech challenges into sustainable open-source tools.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Access Practical Resources</strong>
                    <p>Use playbooks and case studies to grow your digital confidence.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Increase Your Visibility</strong>
                    <p>Share your work & inspire other nonprofits on similar journeys.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tech Expert Benefits -->
            <div class="oasis-card redesigned-card benefits-card">
              <h3>Why Should a Tech Expert Join OASIS?</h3>
              <div class="benefits-list redesigned-list">
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Reach Purpose-Driven Partners</strong>
                    <p>Connect with nonprofits seeking mission-aligned, open-source expertise.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Build Lasting Relationships</strong>
                    <p>Collaborate with sector leaders, implementers, and funders.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Access New Opportunities</strong>
                    <p>Engage in pilots, co-development, and long-term support projects.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Gain Sector Insight</strong>
                    <p>Use shared research and playbooks to design solutions nonprofits truly need.</p>
                  </div>
                </div>
                <div class="benefit">
                  <div class="benefit-icon redesigned-icon">→</div>
                  <div class="benefit-content">
                    <strong>Grow Your Credibility</strong>
                    <p>Showcase your impact and strengthen your reputation in the social sector.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- How to Join & Ready to Join - Right Side -->
          <div class="join-cards-container">
            <div class="oasis-card redesigned-card how-card">
              <h3>How to Join?</h3>
              <p>No long forms. No barriers. Just good intent and open collaboration.</p>
              <ol class="join-steps redesigned-steps">
                <li>
                  <div class="join-step-content">
                    <a href="#">Read the community guidelines here before you join.</a>
                  </div>
                </li>
                <li>
                  <div class="join-step-content">Click Join below</div>
                </li>
                <li>
                  <div class="join-step-content">We'll onboard you quickly</div>
                </li>
              </ol>
              
              <div class="ready-section">
                <h3>Ready to Join?</h3>
                <p>Become part of our growing community of changemakers.</p>
                <a href="#/portal/signup" class="oasis-btn redesigned-btn">Join Now</a>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="oasis-testimonials redesigned-testimonials">
      <div class="section-container">
        <h2 class="oasis-subtitle">What The Oasis Community Has To Say</h2>

        <div class="testimonials-two-column">
          <!-- NPO Says -->
          <div class="testimonial-column">
            <h3 class="testimonial-subheading">NPOs</h3>
            <div class="testimonials-grid">
              {{#get "posts" filter="tag:npo-says" order="published_at desc" limit="3"}}
                {{#foreach posts}}
                  <blockquote class="oasis-quote redesigned-quote">
                    <div class="stars">★★★★★</div>
                    {{#if custom_excerpt}}
                      <p>"{{custom_excerpt}}"</p>
                    {{else}}
                      <p>"{{excerpt words="25"}}"</p>
                    {{/if}}
                    <cite>— {{title}}</cite>
                  </blockquote>
                {{/foreach}}
              {{/get}}
            </div>
            <a href="/tag/npo-says/" class="readmore-btn small">Read More</a>
          </div>

          <!-- Tech Vendor Says -->
          <div class="testimonial-column">
            <h3 class="testimonial-subheading">Tech Experts</h3>
            <div class="testimonials-grid">
              {{#get "posts" filter="tag:tech-experts-says" order="published_at desc" limit="3"}}
                {{#foreach posts}}
                  <blockquote class="oasis-quote redesigned-quote">
                    <div class="stars">★★★★★</div>
                    {{#if custom_excerpt}}
                      <p>"{{custom_excerpt}}"</p>
                    {{else}}
                      <p>"{{excerpt words="25"}}"</p>
                    {{/if}}
                    <cite>— {{title}}</cite>
                  </blockquote>
                {{/foreach}}
              {{/get}}
            </div>
            <a href="/tag/tech-experts-says/" class="readmore-btn small">Read More</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Partners Section -->
    <section class="oasis-partners-section redesigned-partners">
      <div class="section-container">
        <h2 class="oasis-subtitle">Our NGO Partners</h2>
        {{#get "posts" filter="tag:ngo" limit="12" include="feature_image"}}
        <div class="partners-marquee redesigned-marquee">
          <div class="partners-track">
            {{#foreach posts}}
            <a href="{{url}}" class="partner-logo redesigned-logo" title="{{title}}">
              {{#if feature_image}}
                <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
              {{else}}
                <span class="partner-text">{{title}}</span>
              {{/if}}
            </a>
            {{/foreach}}
            
            {{!-- Duplicate for seamless loop --}}
            {{#foreach posts}}
            <a href="{{url}}" class="partner-logo redesigned-logo" title="{{title}}">
              {{#if feature_image}}
                <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
              {{else}}
                <span class="partner-text">{{title}}</span>
              {{/if}}
            </a>
            {{/foreach}}
          </div>
        </div>
        {{/get}}
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="oasis-cta redesigned-cta">
      <div class="section-container">
        <div class="cta-content">
          <h2>Ready to Make an Impact?</h2>
          <p>Join thousands of innovators working together for social good through open-source collaboration.</p>
          <a href="#/portal/signup" class="oasis-btn redesigned-cta-btn">Join the Community Today</a>
        </div>
      </div>
    </section>

  </div>
</main>