{{!< default}}

<main class="full-width">

    <section class="hero-section">
        <img class="hero-image" src="{{@site.cover_image}}" alt="{{@site.title}}">

        <div class="hero-text">
            <span>{{@site.description}}</span>
        </div>
    </section>

    <section class="hero-sub-text">
        <h2>Turning nonprofit tech pain points into open-source breakthroughs.</h2>
    </section>

    <section class="stats-section">
        <div class="stat-box">
            <h3><span class="count" data-target="120">0</span>+</h3>
            <h4>NPO’s have connected with us</h4>
        </div>

        <div class="stat-box">
            <h3><span class="count" data-target="200">0</span>+</h3>
            <h4>Tech experts have attended our events</h4>
        </div>

        <div class="stat-box">
            <h3><span class="count" data-target="12">0</span>+</h3>
            <h4>NPO’s have been mapped to tech experts</h4>
        </div>
    </section>

</main>
