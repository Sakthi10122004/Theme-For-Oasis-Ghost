{{!< default}}

<style>
/* ===============================
   CRITICAL CSS (Inlined for faster rendering)
   =============================== */
:root {
  --hero-primary: #ED3E29;
  --hero-text-light: #fff;
  --hero-bg: #fff;
}

/* Basic layout structure - Critical for initial render */
.hero-orbit {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  padding: 6rem 5%;
  min-height: 80vh;
  max-width: 1600px;
  margin: 0 auto;
  background: var(--hero-bg);
}

.orbit-content {
  max-width: 600px;
  justify-self: start;
}

.hero-title {
  font-size: clamp(1.5rem, 4vw, 4rem);
  line-height: 1.1;
  margin-bottom: 1.5rem;
  font-weight: 550;
}

.hero-desc {
  font-size: clamp(1.1rem, 1.5vw, 1.4rem);
  color: #555;
  margin-bottom: 2.5rem;
  line-height: 1.6;
  max-width: 90%;
}

.hero-cta {
  background: var(--hero-primary);
  color: var(--hero-text-light);
  padding: 1rem 2.5rem;
  border-radius: 50px;
  font-size: 1.1rem;
  font-weight: 600;
  box-shadow: 0 8px 24px rgba(237, 62, 41, 0.3);
  display: inline-block;
  text-decoration: none;
}

.orbit-visual {
  justify-self: end;
  width: 100%;
  max-width: 800px;
}

.floating-img {
  width: 100%;
  height: auto;
  max-height: 600px;
  object-fit: cover;
  border-radius: 24px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.floating-placeholder {
  width: 100%;
  height: 500px;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 1.2rem;
  border: 2px dashed #cbd5e1;
}

/* BBB Section - Critical for layout */
.bbb-section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  max-width: 1400px;
  margin: 0 auto;
  padding: 80px 20px;
  background-color: #fff;
}

.bbb-item {
  text-align: center;
  padding: 40px 20px;
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(237, 62, 41, 0.08);
}

.bbb-item h4 {
  font-size: 2.2rem;
  color: #ED3E29;
  margin: 0 0 15px;
  font-weight: bold;
}

.bbb-img {
  width: 100%;
  max-width: 350px;
  height: 200px;
  margin: 0 auto;
  border-radius: 12px;
  overflow: hidden;
}

.bbb-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Lazy loading styles */
.lazy-load {
  opacity: 0;
  transition: opacity 0.3s;
}

.lazy-loaded {
  opacity: 1;
}

/* Hide preloader */
.preload-critical {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
}

/* Loading animation */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Responsive adjustments for critical layout */
@media (max-width: 992px) {
  .hero-orbit {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 3rem;
    padding: 4rem 5%;
  }
  
  .orbit-content {
    max-width: 100%;
    justify-self: center;
  }
  
  .hero-desc {
    max-width: 100%;
  }
  
  .orbit-visual {
    justify-self: center;
    order: -1;
  }
  
  .bbb-section {
    grid-template-columns: 1fr;
    max-width: 500px;
  }
}

@media (max-width: 768px) {
  .floating-img {
    max-height: 350px;
  }
  
  .bbb-item {
    padding: 25px 15px;
  }
  
  .bbb-item h4 {
    font-size: 1.6rem;
  }
  
  .bbb-img {
    max-width: 200px;
    height: 140px;
  }
}

/* Load deferred CSS without blocking render */
<link rel="preload" href="{{asset 'css/deferred.css'}}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{asset 'css/deferred.css'}}"></noscript>
</style>

<!-- Preload critical images -->
<div class="preload-critical">
  {{#if @site.cover_image}}
    <link rel="preload" as="image" href="{{@site.cover_image}}" fetchpriority="high">
  {{/if}}
  <link rel="preload" as="image" href="{{asset 'images/bridge.webp'}}">
  <link rel="preload" as="image" href="{{asset 'images/build.webp'}}">
  <link rel="preload" as="image" href="{{asset 'images/belong.webp'}}">
</div>

<div class="hero-orbit">
  <div class="orbit-content">
    <h1 class="hero-title">
      <span class="line">The open-source</span>
      <span class="line highlight">collective </span>
      <span class="line">fueling <span class="glow">social impact.</span></span>
    </h1>
    <p class="hero-desc">{{@site.description}}</p>
    <a href="/community" class="hero-cta">Start your journey</a>
  </div>
  <div class="orbit-visual">
    {{#if @site.cover_image}}
      <img 
        src="{{@site.cover_image}}" 
        alt="Open source impact visual" 
        class="floating-img lazy-load" 
        loading="eager"
        fetchpriority="high"
        width="800"
        height="600"
