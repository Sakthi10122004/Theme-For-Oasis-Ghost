        <a href="/tag/latest/" class="update-badge">LATEST</a>

        <div class="update-content">
          {{#if feature_image}}
          <div class="update-img">
            <img src="{{img_url feature_image size="m"}}" alt="{{title}}">
          </div>
          {{/if}}

          <div class="update-text">
            <h4><a href="{{url}}">{{title}}</a></h4>
            {{#if custom_excerpt}}
              <p>{{custom_excerpt}}</p>
            {{else}}
              <p>{{excerpt words="18"}}</p>
            {{/if}}
            <a href="{{slug}}" class="read-more">Read more →</a>
          </div>
        </div>
      </div>
      {{/foreach}}
    {{/get}}
  </div>
</section>


