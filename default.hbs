<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" /> {{!-- Use custom setting so Ghost stops
  warning --}}
  <meta name="x-color-scheme" content="{{@custom.color_scheme}}">

  <title>{{meta_title}}</title>
  <meta name="description" content="{{meta_description}}{{#unless meta_description}}{{@site.description}}{{/unless}}">

  {{!-- Open Graph (Facebook / LinkedIn / Discord previews) --}}
  <meta property="og:site_name" content="{{@site.title}}">
  <meta property="og:title" content="{{meta_title}}">
  <meta property="og:description"
    content="{{meta_description}}{{#unless meta_description}}{{@site.description}}{{/unless}}">
  {{#if @site.cover_image}}
  <meta property="og:image" content="{{@site.cover_image}}">{{/if}}
  <meta property="og:url" content="{{canonical_url}}">
  <meta property="og:type" content="website">

  {{!-- Twitter / X Card --}}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{meta_title}}">
  <meta name="twitter:description"
    content="{{meta_description}}{{#unless meta_description}}{{@site.description}}{{/unless}}">
  {{#if @site.cover_image}}
  <meta name="twitter:image" content="{{@site.cover_image}}">{{/if}}

  {{!-- Add header-ready synchronously so content is NEVER hidden during navigation --}}
  <style>
    /* Only prevent FOUC for nav elements that JS must initialise */
    .nebula-nav-horizontal:not(.nav-ready) .menu-item-has-children>ul {
      display: none !important;
    }
  </style>
  <script>
    // Runs synchronously in <head> — before any HTML is painted.
    // header-ready is set here so .cosmic-flow and .nebula-header
    // are NEVER hidden, eliminating the blank-screen flash on navigation.
    document.documentElement.classList.add('js-ready', 'header-ready');
  </script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="{{asset "js/script.js"}}" defer></script>
  <script src="{{asset "js/ghost-dropdown.js"}}" defer></script>
  <script src="{{asset "js/forms.js"}}" defer></script>
  {{!--
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" /> --}}
  {{!--
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"> --}}
  {{!--
  <link rel="preconnect" href="https://fonts.googleapis.com"> --}}
  {{!--
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> --}}
  {{!--
  <link rel="preload" href="{{asset " fonts/Inter.woff2"}}" as="font" type="font/woff2" crossorigin> --}}
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{asset "css/styles.css"}}" />
  <link rel="stylesheet" href="{{asset "css/index.css"}}" />
  <link rel="stylesheet" href="{{asset "css/about.css"}}" />
  <link rel="stylesheet" href="{{asset "css/author.css"}}" />
  <link rel="stylesheet" href="{{asset "css/tag.css"}}" />
  <link rel="stylesheet" href="{{asset "css/post.css"}}" />
  <link rel="stylesheet" href="{{asset "css/page.css"}}" />
  <link rel="stylesheet" href="{{asset "css/error.css"}}" />
  <link rel="stylesheet" href="{{asset "css/network.css"}}" />
  <link rel="stylesheet" href="{{asset "css/blog.css"}}" />
  <link rel="stylesheet" href="{{asset "css/events.css"}}" />
  <link rel="stylesheet" href="{{asset "css/forms.css"}}" />
  <link rel="stylesheet" href="{{asset "css/responses.css"}}" />
  {{ghost_head}}
</head>

<body class="{{body_class}}">

  <header class="nebula-header">
    <div class="header-content">

      <!-- Logo -->
      <a href="{{@site.url}}" class="logo" aria-label="{{@site.title}}">
        {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}">
        {{else}}
        <span>{{@site.title}}</span>
        {{/if}}
      </a>

      <!-- Desktop Navigation -->
      <nav class="nebula-nav-horizontal" aria-label="Main navigation">
        <ul>
          {{navigation}}
        </ul>

        <!-- Mobile only extra items inside nav -->
        <div class="mobile-extra-items">
          <button class="gh-search-icon" aria-label="Search" data-ghost-search>
            🔍︎ <span>Search</span>
          </button>


          <a href="#" class="join-cta js-get-started">Get started</a>
        </div>
      </nav>

      <!-- Desktop Right Side -->
      <div class="header-right-items">
        <button class="gh-search-icon" aria-label="search" data-ghost-search>
          🔍︎
        </button>

        <a href="#" class="join-cta js-get-started">Get started</a>

      </div>

      <!-- Hamburger -->
      <button class="hamburger" aria-label="Toggle navigation menu">
        <span></span><span></span><span></span>
      </button>

    </div>

  </header>
  <main class="cosmic-flow">
    {{{body}}}
  </main>

  <footer class="stack-footer">
    <div class="footer-inner">

      <nav class="footer-nav-secondary">
        {{navigation type="secondary"}}
      </nav>

      <p class="footer-copy">
        © {{date format="YYYY"}} {{@site.title}}. {{@custom.footer_license}}
      </p>

      {{#if @custom.footer_email}}
      <a href="mailto:{{@custom.footer_email}}" class="footer-mail">
        {{@custom.footer_email}}
      </a>
      {{/if}}

    </div>
  </footer>

  <div id="getStartedModal" class="gs-modal" aria-hidden="true">
    <div class="gs-modal-content">
      <h2>Get Started as</h2>

      <a href="/tech-vendor-form/" class="gs-option">Tech Vendor</a>
      <a href="/non-profits-form/" class="gs-option">Non-Profit</a>
      <a href="/freelancers-form/" class="gs-option">
        Freelancer / Volunteer
      </a>

      <!-- Admin-only: shown when Ghost admin session is active -->
      <a href="/responses/" id="adminResponsesBtn" class="gs-option gs-option--admin" style="display:none">
        View Responses
      </a>

      <button class="gs-close" aria-label="Close">&times;</button>
    </div>
  </div>

  <!-- Announcement Popup Modal (populated by JS from Ghost's native announcement bar) -->
  <div id="announcementPopup" class="announcement-popup" inert role="dialog" aria-modal="true"
    aria-labelledby="announcementPopupSite">
    <div class="announcement-popup-header">
      <div class="announcement-popup-from">
        <span class="announcement-popup-label">Announcement from</span>
        <span class="announcement-popup-site" id="announcementPopupSite">{{@site.title}}</span>
      </div>
      <button class="announcement-popup-close" aria-label="Close announcement"
        id="announcementPopupClose">&times;</button>
    </div>
    <div class="announcement-popup-divider"></div>
    <div class="announcement-popup-body" id="announcementPopupBody"></div>
    <div class="announcement-popup-footer">
      <button class="announcement-popup-dismiss" id="announcementPopupDismiss">Got it</button>
    </div>
  </div>
  <div class="announcement-popup-backdrop" id="announcementPopupBackdrop"></div>

  {{ghost_foot}}
</body>

</html>