<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ED3E29">
  {{!-- Use custom setting so Ghost stops warning --}}
<meta name="x-color-scheme" content="{{@custom.color_scheme}}">

  <title>{{meta_title}}</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="{{asset "css/styles.css"}}" />
  {{!-- {{#is "home"}} --}}
    <link rel="stylesheet" href="{{asset "css/index.css"}}" />
  {{!-- {{/is}} --}}
  <link rel="stylesheet" href="{{asset "css/about.css"}}" />
  <link rel="stylesheet" href="{{asset "css/tag.css"}}" />
  <link rel="stylesheet" href="{{asset "css/post.css"}}" />
  <link rel="stylesheet" href="{{asset "css/error.css"}}" />
  <link rel="stylesheet" href="{{asset "css/community.css"}}" />
  <link rel="stylesheet" href="{{asset "css/ghost-dropdown.css"}}" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  {{ghost_head}} 
</head>
<body class="{{body_class}}">

<header class="nebula-header">
  <div class="header-content">

    <!-- Logo -->
    <a href="{{@site.url}}" class="logo" aria-label="{{@site.title}}">
      {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}">
      {{else}}
        <span>{{@site.title}}</span>
      {{/if}}
    </a>

        <!-- Desktop Navigation -->
    <nav class="nebula-nav-horizontal" aria-label="Main navigation">
      <ul>
        {{navigation}}
      </ul>

      <!-- Mobile only extra items inside nav -->
      <div class="mobile-extra-items">
        {{!-- <button class="gh-search-icon" data-ghost-search></button>
        <a href="#/portal/signup" class="join-cta mobile-join">Join us</a> --}}
      </div>
    </nav>

    <!-- Desktop Right Side -->
    <div class="header-right-items">
      <button class="gh-search-icon" aria-label="search" data-ghost-search>
        🔍︎
      </button>
      <a href="#/portal/signup" class="join-cta">Join us</a>
    </div>

    <!-- Hamburger -->
    <button class="hamburger" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </button>


  </div>
</header>


<main class="cosmic-flow">
  {{{body}}}
</main>

<footer class="minimal-footer">
  <div class="footer-container">

    <!-- Left -->
    <div class="footer-copy">
      © {{date format="YYYY"}} {{@site.title}}. All rights reserved.
      <a href="mailto:hello@oasishq.org" class="contact-link" aria-label="Contact us">
        Contact us
      </a>
    </div>

    <!-- Center -->
    <div class="footer-brand">
      <a href="{{@site.url}}">{{@site.title}}</a>
    </div>

    <!-- Right: SVG Icons -->
    <div class="footer-social">

      <a href="https://twitter.com" target="_blank" aria-label="Twitter">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M22.46 6c-.77.35-1.6.57-2.46.67a4.26 4.26 0 0 0 1.88-2.35a8.38 8.38 0 0 1-2.7 1.03A4.21 4.21 0 0 0 16 4c-2.33 0-4.22 1.89-4.22 4.21c0 .33.04.66.1.97A11.93 11.93 0 0 1 3.15 5.15a4.22 4.22 0 0 0-.57 2.12c0 1.46.75 2.75 1.9 3.5a4.2 4.2 0 0 1-1.9-.52v.05c0 2.04 1.46 3.73 3.4 4.12c-.36.1-.75.15-1.15.15c-.28 0-.55-.02-.82-.08c.55 1.72 2.15 2.97 4.05 3a8.46 8.46 0 0 1-5.25 1.82c-.34 0-.68-.02-1.02-.06A11.94 11.94 0 0 0 8.29 21c7.73 0 11.95-6.4 11.95-11.94c0-.18-.01-.36-.02-.53A8.65 8.65 0 0 0 22.46 6z"/>
        </svg>
      </a>

      <a href="https://facebook.com" target="_blank" aria-label="Facebook">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M22 12a10 10 0 1 0-11.5 9.9v-7h-2v-3h2v-2c0-2 1.2-3.2 3-3.2c.9 0 1.8 0 2 .1v2.2h-1.4c-1.1 0-1.4.7-1.4 1.3V12h3l-.5 3h-2.5v7A10 10 0 0 0 22 12z"/>
        </svg>
      </a>

      <a href="https://instagram.com" target="_blank" aria-label="Instagram">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm10 2c1.7 0 3 1.3 3 3v10c0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3V7c0-1.7 1.3-3 3-3h10zm-5 3.3A4.7 4.7 0 1 0 16.7 12A4.7 4.7 0 0 0 12 7.3zm0 7.7a3 3 0 1 1 3-3a3 3 0 0 1-3 3zm4.8-8.9a1.1 1.1 0 1 1-1.1-1.1a1.1 1.1 0 0 1 1.1 1.1z"/>
        </svg>
      </a>

    </div>

  </div>
</footer>




<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="{{asset "js/script.js"}}"></script>

<!-- jQuery (required by ghost-dynamic-dropdown) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="{{asset "js/ghost-dropdown.js"}}"></script>
{{ghost_foot}}
</body>
</html>