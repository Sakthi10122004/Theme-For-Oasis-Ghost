<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ED3E29">
  {{!-- Use custom setting so Ghost stops warning --}}
<meta name="x-color-scheme" content="{{@custom.color_scheme}}">

  <title>{{meta_title}}</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="{{asset "css/styles.css"}}" />
  {{!-- {{#is "home"}} --}}
    <link rel="stylesheet" href="{{asset "css/index.css"}}" />
  {{!-- {{/is}} --}}
  <link rel="stylesheet" href="{{asset "css/about.css"}}" />
  <link rel="stylesheet" href="{{asset "css/tag.css"}}" />
  <link rel="stylesheet" href="{{asset "css/post.css"}}" />
  <link rel="stylesheet" href="{{asset "css/error.css"}}" />
  <link rel="stylesheet" href="{{asset "css/community.css"}}" />
  <link rel="stylesheet" href="{{asset "css/ghost-dropdown.css"}}" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  {{ghost_head}} 
</head>
<body class="{{body_class}}">

<header class="nebula-header">
  <div class="header-content">

    <!-- Logo -->
    <a href="{{@site.url}}" class="logo" aria-label="{{@site.title}}">
      {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}">
      {{else}}
        <span>{{@site.title}}</span>
      {{/if}}
    </a>

        <!-- Desktop Navigation -->
    <nav class="nebula-nav-horizontal" aria-label="Main navigation">
      <ul>
        {{navigation}}
      </ul>

      <!-- Mobile only extra items inside nav -->
      <div class="mobile-extra-items">
        {{!-- <button class="gh-search-icon" data-ghost-search></button>
        <a href="#/portal/signup" class="join-cta mobile-join">Join us</a> --}}
      </div>
    </nav>

    <!-- Desktop Right Side -->
    <div class="header-right-items">
      <button class="gh-search-icon" aria-label="search" data-ghost-search>
        🔍︎
      </button>
      <a href="#/portal/signup" class="join-cta">Join us</a>
    </div>

    <!-- Hamburger -->
    <button class="hamburger" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </button>


  </div>
</header>


<main class="cosmic-flow">
  {{{body}}}
</main>

<footer class="minimal-footer">
  <div class="footer-container">

    <!-- Left -->
    <div class="footer-copy">
      © {{date format="YYYY"}} {{@site.title}}. All rights reserved.
      <a href="mailto:hello@oasishq.org" class="contact-link" aria-label="Contact us">
        Contact us
      </a>
    </div>

    <!-- Center -->
    <div class="footer-brand">
      <a href="{{@site.url}}">{{@site.title}}</a>
    </div>

    <!-- Right: SVG Icons -->
    <div class="footer-social">

      <a href="https://www.linkedin.com/company/oasishq" target="_blank" aria-label="LinkedIn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5zM3 9h4v12H3zm6 0h3.6v1.5h.05c.5-.9 1.7-1.8 3.45-1.8 3.54 0 4 2.3 4 5.3V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9z"/>
        </svg>
      </a>

      <a href="https://chat.whatsapp.com/ByCC1QMFniO40Yg4M3ex1W?mode=ems_copy_t" target="_blank" aria-label="WhatsApp">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.04 2C6.59 2 2.23 6.22 2.23 11.56c0 2.02.63 3.89 1.71 5.45L2 22l5.17-1.85c1.51.83 3.24 1.28 5.04 1.28 5.45 0 9.81-4.22 9.81-9.56S17.49 2 12.04 2zm0 17.59c-1.54 0-3.03-.41-4.33-1.19l-.31-.18-3.07 1.1 1.05-2.92-.2-.3a7.47 7.47 0 01-1.36-4.44c0-4.16 3.47-7.55 7.72-7.55 4.26 0 7.73 3.39 7.73 7.55s-3.47 7.55-7.73 7.55zm4.17-5.59c-.23-.11-1.36-.67-1.57-.74-.21-.08-.36-.11-.51.11-.15.23-.58.74-.71.89-.13.15-.26.17-.49.06-.23-.11-.96-.35-1.83-1.12-.68-.6-1.14-1.34-1.28-1.57-.13-.23-.01-.35.1-.46.1-.1.23-.26.34-.39.11-.13.15-.23.23-.38.08-.15.04-.28-.02-.39-.06-.11-.51-1.23-.7-1.68-.18-.44-.37-.38-.51-.39-.13-.01-.28-.01-.43-.01-.15 0-.39.06-.6.28-.21.23-.79.77-.79 1.87s.81 2.23.93 2.38c.11.15 1.6 2.5 4.02 3.5.56.24.99.38 1.33.49.56.18 1.06.15 1.46.09.45-.07 1.36-.55 1.55-1.09.19-.54.19-1.02.13-1.12-.06-.1-.21-.16-.43-.26z"/>
          </svg>
      </a>

      <a href="https://www.instagram.com/hq_oasis?igsh=MTJjeno5ZmNmMjJsaw==" target="_blank" aria-label="Instagram">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm10 2c1.7 0 3 1.3 3 3v10c0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3V7c0-1.7 1.3-3 3-3h10zm-5 3.3A4.7 4.7 0 1 0 16.7 12A4.7 4.7 0 0 0 12 7.3zm0 7.7a3 3 0 1 1 3-3a3 3 0 0 1-3 3zm4.8-8.9a1.1 1.1 0 1 1-1.1-1.1a1.1 1.1 0 0 1 1.1 1.1z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>




<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="{{asset "js/script.js"}}"></script>

<!-- jQuery (required by ghost-dynamic-dropdown) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="{{asset "js/ghost-dropdown.js"}}"></script>
{{ghost_foot}}
</body>
</html>