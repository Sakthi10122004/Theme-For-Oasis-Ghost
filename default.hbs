<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" /> {{!-- Use custom setting so Ghost stops
  warning --}}
  <meta name="x-color-scheme" content="{{@custom.color_scheme}}">

  <title>{{meta_title}}</title>
  {{!-- Critical CSS to prevent FOUC (Flash of Unstyled Content) --}}
  <style>
    /* Unified Reveal: Hold entire page until header is ready */
    .nebula-header,
    .cosmic-flow {
      opacity: 0 !important;
      visibility: hidden !important;
      will-change: opacity, transform;
    }

    /* Simultaneous bloom for professional look */
    .header-ready .nebula-header,
    .header-ready .cosmic-flow {
      opacity: 1 !important;
      visibility: visible !important;
      transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
  </style>
  {{block "head"}}
  <script>document.documentElement.classList.add("js-ready");</script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="{{asset "js/script.js"}}" defer></script>
  <script src="{{asset "js/ghost-dropdown.js"}}" defer></script>
  {{!--
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script> --}}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  {{!--
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" /> --}}
  {{!--
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"> --}}
  {{!--
  <link rel="preconnect" href="https://fonts.googleapis.com"> --}}
  {{!--
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> --}}
  {{!--
  <link rel="preload" href="{{asset " fonts/Inter.woff2"}}" as="font" type="font/woff2" crossorigin> --}}
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{asset "css/styles.css"}}" />
  <link rel="stylesheet" href="{{asset "css/index.css"}}" />
  <link rel="stylesheet" href="{{asset "css/about.css"}}" />
  <link rel="stylesheet" href="{{asset "css/author.css"}}" />
  <link rel="stylesheet" href="{{asset "css/tag.css"}}" />
  <link rel="stylesheet" href="{{asset "css/post.css"}}" />
  <link rel="stylesheet" href="{{asset "css/page.css"}}" />
  <link rel="stylesheet" href="{{asset "css/error.css"}}" />
  <link rel="stylesheet" href="{{asset "css/network.css"}}" />
  <link rel="stylesheet" href="{{asset "css/blog.css"}}" />
  <link rel="stylesheet" href="{{asset "css/events.css"}}" />
  <link rel="stylesheet" href="{{asset "css/ghost-dropdown.css"}}" />
  {{ghost_head}}
</head>

<body class="{{body_class}}">

  <header class="nebula-header">
    <div class="header-content">

      <!-- Logo -->
      <a href="{{@site.url}}" class="logo" aria-label="{{@site.title}}">
        {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}">
        {{else}}
        <span>{{@site.title}}</span>
        {{/if}}
      </a>

      <!-- Desktop Navigation -->
      <nav class="nebula-nav-horizontal" aria-label="Main navigation">
        <ul>
          {{navigation}}
        </ul>

        <!-- Mobile only extra items inside nav -->
        <div class="mobile-extra-items">
          <button class="gh-search-icon" aria-label="Search" data-ghost-search>
            🔍︎ <span>Search</span>
          </button>


          <a href="#" class="join-cta js-get-started">Get started</a>
        </div>
      </nav>

      <!-- Desktop Right Side -->
      <div class="header-right-items">
        <button class="gh-search-icon" aria-label="search" data-ghost-search>
          🔍︎
        </button>


        <a href="#" class="join-cta js-get-started">Get started</a>


      </div>

      <!-- Hamburger -->
      <button class="hamburger" aria-label="Toggle navigation menu">
        <span></span><span></span><span></span>
      </button>

    </div>

  </header>
  <main class="cosmic-flow">
    {{{body}}}
  </main>

  <footer class="stack-footer">
    <div class="footer-inner">

      <div class="footer-brand-social">
        <div class="footer-social">

          <a href="https://www.linkedin.com/company/oasishq" target="_blank" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="4" width="16" height="16" rx="2" />
              <line x1="8" y1="11" x2="8" y2="16" />
              <line x1="8" y1="8" x2="8" y2="8.01" />
              <path d="M12 16v-5a2 2 0 0 1 2 -2a2 2 0 0 1 2 2v5" />
            </svg>
          </a>

          <a href="https://chat.whatsapp.com/ByCC1QMFniO40Yg4M3ex1W?mode=ems_copy_t" target="_blank"
            aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
              <path
                d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
            </svg>
          </a>

          <a href="https://www.instagram.com/hq_oasis?igsh=MTJjeno5ZmNmMjJsaw==" target="_blank" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="4" width="16" height="16" rx="4" />
              <circle cx="12" cy="12" r="3" />
              <line x1="16.5" y1="7.5" x2="16.5" y2="7.501" />
            </svg>
          </a>

        </div>
      </div>

      <p class="footer-copy">
        © {{date format="YYYY"}} {{@site.title}}. {{@custom.footer_license}}
      </p>

      {{#if @custom.footer_email}}
      <a href="mailto:{{@custom.footer_email}}" class="footer-mail">
        {{@custom.footer_email}}
      </a>
      {{/if}}

    </div>
  </footer>

  <div id="getStartedModal" class="gs-modal" aria-hidden="true">
    <div class="gs-modal-content">
      <h2>Get Started as</h2>

      <a href="/tech-vendor/" class="gs-option">Tech Vendor</a>
      <a href="/non-profits/" class="gs-option">Non-Profit</a>
      <a href="/freelancer-volunteer/" class="gs-option">
        Freelancer / Volunteer
      </a>

      <button class="gs-close" aria-label="Close">&times;</button>
    </div>
  </div>

  {{ghost_foot}}
</body>

</html>