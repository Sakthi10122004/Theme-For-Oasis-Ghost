                <circle cx="100" cy="100" r="80" fill="none" stroke="#ED3E29" stroke-width="4"/>
                <path d="M70 130 Q100 150 130 130" fill="none" stroke="#ED3E29" stroke-width="4" stroke-linecap="round"/>
                <circle cx="75" cy="80" r="8" fill="#ED3E29"/>
                <circle cx="125" cy="80" r="8" fill="#ED3E29"/>
            </svg>
        </div>
        <div class="error-number">404</div>
        <h1>Page not found</h1>
