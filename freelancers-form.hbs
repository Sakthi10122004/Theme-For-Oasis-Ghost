{{!< default}}

<section class="oasis-form-page">

  <!-- Hero -->
  <div class="oasis-form-hero">
    <span class="oasis-form-badge">Join the Network</span>
    <h1>Freelancers & Volunteers</h1>
    <p>OASIS is building a trusted community of tech contributors to support nonprofits with open-source solutions. Tell us about your skills and how you'd like to help.</p>
  </div>

  <!-- Form Card -->
  <div class="oasis-form-card">
    <form id="freelancerForm" novalidate>

      <!-- Section 1: Personal Info -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Your Details</div>
        <div class="form-fields cols-2">
          <div class="form-group">
            <label for="contributor_name">Full Name <span class="required">*</span></label>
            <input id="contributor_name" type="text" placeholder="e.g. Alex Johnson" required>
          </div>
          <div class="form-group">
            <label for="contributor_phone">Phone Number <span class="required">*</span></label>
            <input id="contributor_phone" type="tel" inputmode="numeric" maxlength="10" placeholder="e.g. 9876543210" required>
          </div>
          <div class="form-group form-field-full">
            <label for="contributor_email">Email Address <span class="required">*</span></label>
            <input id="contributor_email" type="email" placeholder="e.g. alex@example.com" required>
          </div>
        </div>
      </div>

      <!-- Section 2: Skills -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Skills & Contribution</div>
        <div class="form-fields">
          <div class="form-group form-field-full">
            <label for="contributor_expertise">Area of Expertise <span class="required">*</span></label>
            <input id="contributor_expertise" type="text" placeholder="e.g. Frontend Development, Data Analysis, Graphic Design" required>
          </div>
          <div class="form-group form-field-full">
            <label for="contributor_contribution">How would you like to contribute? <span class="required">*</span></label>
            <textarea id="contributor_contribution" placeholder="Describe how you'd like to help nonprofits through OASIS..." required></textarea>
          </div>
        </div>
      </div>

      <!-- Honeypot -->
      <div class="form-honeypot" aria-hidden="true">
        <input id="freelancer_bot_field" tabindex="-1" autocomplete="off">
      </div>

      <!-- Status -->
      <div id="freelancerStatus" class="form-status"></div>

      <!-- Footer -->
      <div class="oasis-form-footer">
        <p class="oasis-form-footer-note">
          Visit us at <a href="https://www.oasishq.org" target="_blank">oasishq.org</a>
        </p>
        <button type="submit" class="oasis-form-submit" id="freelancerSubmitBtn">
          Submit Registration →
        </button>
      </div>

    </form>
  </div>

</section>