{{!< default}} <div class="oasis-org-form">

    <!-- Intro Section -->
    <div class="oasis-org-intro">
        <p>
            OASIS is building a trusted network of tech service providers to support nonprofits with open-source
            solutions.
            By joining, you’ll get matched with business opportunities from social sector organisations looking for
            ethical, impact-focused tech support.
            Fill this quick form so we can understand your organisation and match you with the right tech partners.
            Let’s power social change through open tech.
        </p>
        <p class="oasis-org-link">
            Visit us at
            <a href="https://www.oasishq.org" target="_blank" rel="noopener">
                www.oasishq.org
            </a>
        </p>
    </div>

    <div class="oasis-org-container">

        <iframe name="org_hidden_iframe" style="display:none;"></iframe>

        <h2>Non-Profits</h2>

        <form id="orgForm"
            action="https://docs.google.com/forms/d/e/1FAIpQLSdBNgOrQyyUvmD8gcJqSb2XNplWXbtmdHvmPs7JR5vfdtx_QQ/formResponse"
            method="POST" target="org_hidden_iframe">

            <div class="form-group">
                <label>Organisation Name *</label>
                <input type="text" name="entry.360719801" id="org_name" placeholder="e.g., Green Earth NGO" required>
            </div>

            <div class="form-group">
                <label>Website Link</label>
                <input type="url" name="entry.1762102937" id="org_website" placeholder="https://example.org">
            </div>

            <div class="form-group">
                <label>Point of Contact Name *</label>
                <input type="text" name="entry.1979148429" id="org_contact_name" pattern="[A-Za-z ]{2,50}"
                    placeholder="e.g., Jane Doe" required>
            </div>

            <div class="form-group">
                <label>Point of Contact Number *</label>
                <input type="tel" name="entry.1212591437" id="org_contact_number" pattern="[6-9][0-9]{9}" maxlength="10"
                    inputmode="numeric" placeholder="e.g., 9876543210" required>
            </div>

            <div class="form-group">
                <label>Point of Contact Mail ID *</label>
                <input type="email" name="entry.825369272" id="org_email" placeholder="e.g., jane@example.org" required>
            </div>

            <button type="submit">Submit Registration</button>
        </form>
    </div>

    <!-- Success Popup -->
    <div class="overlay" id="orgOverlay">
        <div class="popup">
            <div class="tick">✔</div>
            <h3>Response Saved</h3>
            <p>Your details have been submitted successfully.</p>
            <div class="countdown">
                Redirecting in <span id="orgTimer">5</span> seconds...
            </div>
        </div>
    </div>

    </div>