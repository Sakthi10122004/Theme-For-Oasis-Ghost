{{!< default}}

<section class="oasis-form-page">

  <!-- Hero -->
  <div class="oasis-form-hero">
    <span class="oasis-form-badge">Join the Network</span>
    <h1>Non-Profit Registration</h1>
    <p>OASIS matches nonprofits with trusted tech partners and open-source solutions. Share your organisation's details so we can connect you with the right support.</p>
  </div>

  <!-- Form Card -->
  <div class="oasis-form-card">
    <form id="nonprofitForm" novalidate>

      <!-- Section 1: Organisation Info -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Organisation Details</div>
        <div class="form-fields cols-2">
          <div class="form-group form-field-full">
            <label for="org_name">Organisation Name <span class="required">*</span></label>
            <input id="org_name" type="text" placeholder="e.g. Green Earth NGO" required>
          </div>
          <div class="form-group form-field-full">
            <label for="org_website">Website Link</label>
            <input id="org_website" type="url" placeholder="https://example.org">
          </div>
        </div>
      </div>

      <!-- Section 2: Point of Contact -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Point of Contact</div>
        <div class="form-fields cols-2">
          <div class="form-group">
            <label for="org_contact_name">Contact Name <span class="required">*</span></label>
            <input id="org_contact_name" type="text" placeholder="e.g. Jane Doe" required>
          </div>
          <div class="form-group">
            <label for="org_contact_number">Contact Number <span class="required">*</span></label>
            <input id="org_contact_number" type="tel" inputmode="numeric" maxlength="10" placeholder="e.g. 9876543210" required>
          </div>
          <div class="form-group form-field-full">
            <label for="org_email">Contact Email <span class="required">*</span></label>
            <input id="org_email" type="email" placeholder="e.g. jane@example.org" required>
          </div>
        </div>
      </div>

      <!-- Honeypot -->
      <div class="form-honeypot" aria-hidden="true">
        <input id="nonprofit_bot_field" tabindex="-1" autocomplete="off">
      </div>

      <!-- Status -->
      <div id="nonprofitStatus" class="form-status"></div>

      <!-- Footer -->
      <div class="oasis-form-footer">
        <p class="oasis-form-footer-note">
          Visit us at <a href="https://www.oasishq.org" target="_blank">oasishq.org</a>
        </p>
        <button type="submit" class="oasis-form-submit" id="nonprofitSubmitBtn">
          Submit Registration →
        </button>
      </div>

    </form>
  </div>

</section>