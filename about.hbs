{{!< default}} <script>
  document.addEventListener("DOMContentLoaded", function () {
  document.title = "About";
  });
  </script>

  <main class="about-page">
    <section class="heros-section">
      <div class="container">
        <h1 class="heros-title">How Filter Coffee,<span class="highlight">FOSS</span>, and a Few Restless Minds Started
          a Movement.</h1>
        <p class="heros-subtitle">Discover the story behind OASIS – where passion for open-source meets the drive to
          transform the social sector.</p>

        <div class="heros-image-wrapper">
          <img
            src="{{#if @custom.about_hero_image}}{{@custom.about_hero_image}}{{else}}{{asset 'images/team.webp'}}{{/if}}"
            alt="Group photo at OASIS event" class="hero-image" loading="eager">
        </div>

        <h2 class="heros-context">Being long-time FOSS advocates, we knew high-quality, low-cost open tech was
          everywhere, so the real "wait a minute…" moment was this:</h2>
      </div>
    </section>

    <section class="timeline-section">
      <div class="container-wide">

        <h2 class="section-title">
          Why does the social sector still struggle with tech?
        </h2>

        <div class="timeline">

          <!-- horizontal line -->
          <div class="timeline-line"></div>

          <!-- TOP ROW -->
          <div class="timeline-row">

            <div class="timeline-step">
              <span class="timeline-dot"></span>
              <div class="timeline-card">
                When the world's biggest servers hum on open-source code, it's ironic
                that nonprofits still run on Google Sheets.
              </div>
            </div>

            <div class="timeline-step">
              <span class="timeline-dot"></span>
              <div class="timeline-card">
                <strong>FOSS United, Tech4Good Community, Reap Benefit, Aikyam,
                  & TinkerHub</strong> began experimenting, from tech volunteering
                to open-source pilots for NGOs.
              </div>
            </div>

            <div class="timeline-step">
              <span class="timeline-dot"></span>
              <div class="timeline-card">
                Scattered efforts and caffeine-fueled chats at the
                <strong>JP Nagar office</strong> drew tinkerers together to
                build real tech muscle.
              </div>
            </div>

            <div class="timeline-step">
              <span class="timeline-dot"></span>
              <div class="timeline-card">
                Fixes couldn’t be quick hacks. The sector needed a shift,
                from <strong>“good-to-have”</strong> to
                <strong>essential</strong>.
              </div>
            </div>

          </div>

          <!-- FINAL -->
          <div class="timeline-final">
            <div class="timeline-card timeline-final-card">
              <h3 class="timeline-title">OASIS</h3>
              <p>
                In 2023, we hosted the first-ever OASIS Summit at BIC Bengaluru.
                By mid-2024, with support from the Samagata Foundation,
                OASIS became a full-time team and a growing movement
                proving open tech can drive open change.
              </p>
            </div>

          </div>

        </div>
      </div>
    </section>

    {{#get "posts"
    filter="tag:board"
    limit="99"
    order="published_at desc"}}

    {{#if posts}}
    <section class="board-section">
      <div class="container">
        <h2 class="section-title">Our Board</h2>

        <div class="board-grid">
          {{#foreach posts}}
          <div class="board-member">
            {{#if feature_image}}
            <img src="{{img_url feature_image size=" s"}}" alt="{{title}}" loading="lazy">
            {{/if}}
            <h3>{{title}}</h3>
            {{#if custom_excerpt}}
            <p>{{custom_excerpt}}</p>
            {{/if}}
          </div>
          {{/foreach}}
        </div>
      </div>
    </section>
    {{/if}}

    {{/get}}

    {{#get "posts"
    filter="tag:team"
    limit="99"
    order="published_at asc"}}

    {{#if posts}}

    <section class="team-section">
      <div class="container">
        <h2 class="section-title">Our Team</h2>

        <div class="team-grid">

          {{#foreach posts}}
          <div class="team-member">

            {{#if feature_image}}
            <img src="{{img_url feature_image size=" m"}}" alt="{{title}}" loading="lazy">
            {{/if}}

            <div class="team-content">
              <h3>{{title}}</h3>

              {{#if custom_excerpt}}
              <div class="team-role">{{custom_excerpt}}</div>
              {{/if}}

              <div class="team-bio">
                {{content}}
              </div>
            </div>

          </div>
          {{/foreach}}

        </div>
      </div>
    </section>

    {{/if}}
    {{/get}}

    <section class="mission-section">
      <div class="container">
        <h2 class="section-title">Our Vision & Impact</h2>
        <div class="mission-grid">
          <div class="mission-card mission-card-primary">
            <div class="card-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5z" />
                <path d="M2 17l10 5 10-5" />
                <path d="M2 12l10 5 10-5" />
              </svg>
            </div>
            <h3>Our Mission</h3>
            <p>To bridge the technology gap in the social sector by fostering open-source innovation, collaboration, and
              sustainable solutions that empower nonprofits and social enterprises worldwide.</p>
          </div>
          <div class="mission-card mission-card-secondary">
            <div class="card-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </div>
            <h3>Our Values</h3>
            <ul>
              <li>
                <span class="value-icon">◆</span>
                <div>
                  <strong>Open Collaboration & Innovation:</strong> Co-creating transparent, community-led solutions
                  that push what’s possible.
                </div>
              </li>
              <li>
                <span class="value-icon">◆</span>
                <div>
                  <strong>Sustainability:</strong> Building tech that lasts, affordable, adaptable, and accessible over
                  time.
                </div>
              </li>
              <li>
                <span class="value-icon">◆</span>
                <div>
                  <strong>Inclusion:</strong> Ensuring everyone can use, shape, and benefit from open technology.
                </div>
              </li>
            </ul>
          </div>
          <div class="mission-card mission-card-accent">
            <div class="card-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
              </svg>
            </div>
            <h3>Our Impact</h3>
            <p>Since our inception, OASIS has catalyzed numerous open-source projects, trained numerous developers and
              partnered with leading nonprofits to deliver technology solutions that create lasting social change.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>Join the Movement</h2>
          <p>Be part of the open-source revolution transforming the social sector. Whether you're a developer, nonprofit
            leader, or a philanthropic institution, there's a place for you in our community.</p>
          <a href="#" class="cta-button js-get-started">Get Started</a>
        </div>
      </div>
    </section>
  </main>