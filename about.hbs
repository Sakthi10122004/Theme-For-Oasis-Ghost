{{!-- javaScript for board members slide show --}}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const track = document.getElementById('boardsTrack');
  const dotsContainer = document.getElementById('carouselDots');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  const cards = document.querySelectorAll('.boards-member.redesigneds-member');
  const cardWidth = cards[0].offsetWidth + 30;
  const totalSlides = cards.length / 2; // 9 real + 9 duplicate = 18
  let currentIndex = 0;
  let isDragging = false;
  let startX, scrollLeft;
  let autoPlay;

  // Create dots (9 real members)
  for (let i = 0; i < 9; i++) {
    const dot = document.createElement('div');
    dot.classList.add('dot');
    if (i === 0) dot.classList.add('active');
    dot.addEventListener('click', () => goToSlide(i));
    dotsContainer.appendChild(dot);
  }

  const dots = document.querySelectorAll('.dot');

  function goToSlide(index) {
    currentIndex = index;
    track.style.transform = `translateX(-${currentIndex * cardWidth}px)`;
    updateDots();
  }

  function nextSlide() {
    currentIndex = (currentIndex + 1) % 9;
    if (currentIndex === 0) {
      track.style.transition = 'none';
      track.style.transform = `translateX(0px)`;
      setTimeout(() => {
        track.style.transition = 'transform 1s cubic-bezier(1, 1, 1, 1)';
        currentIndex = 1;
        track.style.transform = `translateX(-${cardWidth}px)`;
        updateDots();
      }, 50);
    } else {
      track.style.transform = `translateX(-${currentIndex * cardWidth}px)`;
      updateDots();
    }
  }

  function prevSlide() {
    currentIndex = (currentIndex - 1 + 9) % 9;
    track.style.transform = `translateX(-${currentIndex * cardWidth}px)`;
    updateDots();
  }

  function updateDots() {
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === currentIndex);
    });
  }

  function startAutoPlay() {
    autoPlay = setInterval(nextSlide, 4000);
  }

  function stopAutoPlay() {
    clearInterval(autoPlay);
  }

  // Mouse drag
  track.addEventListener('mousedown', (e) => {
    isDragging = true;
    startX = e.pageX;
    scrollLeft = track.scrollLeft;
    stopAutoPlay();
  });

  track.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    e.preventDefault();
    const x = e.pageX;
    const walk = (x - startX) * 2;
    track.scrollLeft = scrollLeft - walk;
  });

  ['mouseup', 'mouseleave'].forEach(event => {
    track.addEventListener(event, () => {
      if (isDragging) {
        isDragging = false;
        startAutoPlay();
      }
    });
  });

  // Touch support
  ['touchstart', 'touchmove', 'touchend'].forEach((event, i, arr) => {
    track.addEventListener(event, (e) => {
      if (event === 'touchstart') {
        isDragging = true;
        startX = e.touches[0].pageX;
        scrollLeft = track.scrollLeft;
        stopAutoPlay();
      } else if (event === 'touchmove' && isDragging) {
        const x = e.touches[0].pageX;
        const walk = (x - startX) * 2;
        track.scrollLeft = scrollLeft - walk;
      } else if (event === 'touchend') {
        isDragging = false;
        startAutoPlay();
      }
    });
  });

  // Buttons
  nextBtn.addEventListener('click', () => { stopAutoPlay(); nextSlide(); startAutoPlay(); });
  prevBtn.addEventListener('click', () => { stopAutoPlay(); prevSlide(); startAutoPlay(); });

  // Start
  startAutoPlay();

  // Responsive
  window.addEventListener('resize', () => {
    const newCardWidth = cards[0].offsetWidth + 30;
    track.style.transform = `translateX(-${currentIndex * newCardWidth}px)`;
  });
});
</script>

