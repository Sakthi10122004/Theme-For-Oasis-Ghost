<!-- Mission & Values Section -->
<section class="mission-section redesigneds-mission">
  <div class="containers">
    <div class="mission-content">
      <div class="mission-item">
        <div class="mission-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L13.09 8.26L20 9L13.09 9.74L12 16L10.91 9.74L4 9L10.91 8.26L12 2Z"/>
          </svg>
        </div>
        <h3>Our Mission</h3>
        <p>To bridge the technology gap in the social sector by fostering open-source innovation, collaboration, and sustainable solutions that empower nonprofits and social enterprises worldwide.</p>
      </div>
      <div class="mission-item">
        <div class="mission-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
        </div>
        <h3>Our Values</h3>
        <ul>
          <li><strong>Open Collaboration:</strong> Building together through transparent, community-driven development</li>
          <li><strong>Innovation:</strong> Pushing boundaries to create cutting-edge solutions for social impact</li>
          <li><strong>Sustainability:</strong> Ensuring long-term viability and accessibility of our initiatives</li>
          <li><strong>Inclusion:</strong> Making technology accessible to all, regardless of background or resources</li>
        </ul>
      </div>
      <div class="mission-item">
        <div class="mission-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63C19.68 7.55 18.92 7 18.06 7h-.12c-.86 0-1.63.55-1.9 1.37L13.5 16H16v6c0 1.1.9 2 2 2s2-.9 2-2z"/>
          </svg>
        </div>
        <h3>Impact</h3>
        <p>Since our inception, OASIS has catalyzed numerous open-source projects, trained numerous developers and partnered with leading nonprofits to deliver technology solutions that create lasting social change.</p>
      </div>
    </div>
  </div>
</section>

