{{!< default}}

<section class="oasis-form-page">

  <!-- Hero -->
  <div class="oasis-form-hero">
    <span class="oasis-form-badge">Join the Network</span>
    <h1>Tech Vendor Registration</h1>
    <p>OASIS connects trusted tech vendors with nonprofits building social impact. Fill in your details so we can match you with the right opportunities.</p>
  </div>

  <!-- Form Card -->
  <div class="oasis-form-card">
    <form id="techForm" novalidate>

      <!-- Section 1: Basic Info -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Basic Information</div>
        <div class="form-fields cols-2">
          <div class="form-group">
            <label for="organization_name">Organisation Name <span class="required">*</span></label>
            <input id="organization_name" type="text" placeholder="e.g. Green Stack Labs" required>
          </div>
          <div class="form-group">
            <label for="contact_person">Contact Person & Designation <span class="required">*</span></label>
            <input id="contact_person" type="text" placeholder="e.g. Priya S, CTO" required>
          </div>
          <div class="form-group">
            <label for="email">Email Address <span class="required">*</span></label>
            <input id="email" type="email" placeholder="e.g. hello@yourorg.com" required>
          </div>
          <div class="form-group">
            <label for="phone">Phone Number <span class="required">*</span></label>
            <input id="phone" type="tel" inputmode="numeric" maxlength="10" placeholder="e.g. 9876543210">
          </div>
          <div class="form-group">
            <label for="team_size">Team Size <span class="required">*</span></label>
            <input id="team_size" type="number" min="1" placeholder="e.g. 12">
          </div>
          <div class="form-group">
            <label for="location">Location (City) <span class="required">*</span></label>
            <input id="location" type="text" placeholder="e.g. Bangalore">
          </div>
        </div>
      </div>

      <!-- Section 2: Online Presence -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Online Presence</div>
        <div class="form-fields cols-2">
          <div class="form-group">
            <label for="website">Website</label>
            <input id="website" type="url" placeholder="https://yourorg.com">
          </div>
          <div class="form-group">
            <label for="github">GitHub / Portfolio</label>
            <input id="github" type="url" placeholder="https://github.com/yourorg">
          </div>
        </div>
      </div>

      <!-- Section 3: About -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">About Your Organisation</div>
        <div class="form-fields">
          <div class="form-group form-field-full">
            <label for="description">Organisation / Services Description</label>
            <textarea id="description" placeholder="Briefly describe what your organisation does and the tech services you offer..."></textarea>
          </div>
        </div>
      </div>

      <!-- Section 4: Expertise -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Experience & Expertise</div>
        <div class="form-fields cols-3">
          <div class="form-group">
            <label for="experience_years">Years of Experience</label>
            <input id="experience_years" type="number" min="0" placeholder="e.g. 5">
          </div>
          <div class="form-group">
            <label for="expertise">Core Areas of Expertise</label>
            <input id="expertise" type="text" placeholder="e.g. Web Dev, Data">
          </div>
          <div class="form-group">
            <label for="other_expertise">Other Areas</label>
            <input id="other_expertise" type="text" placeholder="e.g. UX Design">
          </div>
        </div>
      </div>

      <!-- Section 5: NGO & FOSS -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">NGO Experience & Open Source</div>
        <div class="form-fields cols-3">
          <div class="form-group">
            <label for="worked_with_ngos">Previously worked with NGOs?</label>
            <select id="worked_with_ngos">
              <option value="">Select...</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
          <div class="form-group">
            <label for="foss_preference">FOSS-first approach?</label>
            <select id="foss_preference">
              <option value="">Select...</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
          <div class="form-group">
            <label for="open_source_alignment">Aligned with Open Source values?</label>
            <select id="open_source_alignment">
              <option value="">Select...</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
          <div class="form-group form-field-full">
            <label for="foss_tools">FOSS Tools you use</label>
            <textarea id="foss_tools" placeholder="e.g. Linux, PostgreSQL, WordPress, OpenStreetMap..."></textarea>
          </div>
        </div>
      </div>

      <!-- Section 6: Services & Capacity -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Services & Capacity</div>
        <div class="form-fields cols-3">
          <div class="form-group">
            <label for="capacity_building">Provide Training / Capacity Building?</label>
            <select id="capacity_building">
              <option value="">Select...</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
          <div class="form-group">
            <label for="project_size">Typical Project Size</label>
            <select id="project_size">
              <option value="">Select...</option>
              <option>Below 50k</option>
              <option>50k–1L</option>
              <option>1L–5L</option>
              <option>Above 5L</option>
            </select>
          </div>
          <div class="form-group">
            <label for="small_projects">Accept Small Projects?</label>
            <select id="small_projects">
              <option value="">Select...</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
          <div class="form-group">
            <label for="availability">Available for 3–6 month engagements?</label>
            <select id="availability">
              <option value="">Select...</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Section 7: Additional -->
      <div class="oasis-form-section">
        <div class="oasis-form-section-title">Additional Information</div>
        <div class="form-fields">
          <div class="form-group form-field-full">
            <label for="past_projects">Past Projects (brief description)</label>
            <textarea id="past_projects" placeholder="Tell us about relevant work you've done..."></textarea>
          </div>
          <div class="form-group form-field-full">
            <label for="challenges">Challenges working with NGOs (if any)</label>
            <textarea id="challenges" placeholder="Any past challenges or learnings..."></textarea>
          </div>
          <div class="form-group form-field-full">
            <label for="why_join">Why do you want to join OASIS?</label>
            <textarea id="why_join" placeholder="What motivates you to be part of this network?"></textarea>
          </div>
          <div class="form-group form-field-full">
            <label for="expected_support">What support do you expect from OASIS?</label>
            <textarea id="expected_support" placeholder="Business leads, visibility, community, mentorship..."></textarea>
          </div>
        </div>
      </div>

      <!-- Honeypot -->
      <div class="form-honeypot" aria-hidden="true">
        <input id="bot_field" tabindex="-1" autocomplete="off">
      </div>

      <!-- Status -->
      <div id="techStatus" class="form-status"></div>

      <!-- Footer -->
      <div class="oasis-form-footer">
        <p class="oasis-form-footer-note">
          By submitting, you agree to our <a href="https://www.oasishq.org" target="_blank">terms of engagement</a>.
        </p>
        <button type="submit" class="oasis-form-submit" id="techSubmitBtn">
          Submit Registration →
        </button>
      </div>

    </form>
  </div>

</section>