{{!< default}}

{{#post}}

<main id="site-main" class="page-wrapper">

    <!-- FEATURE IMAGE (optional) -->
    {{#if feature_image}}
    <figure class="page-feature-image gh-canvas">
        <img
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w,
                    {{img_url feature_image size="xl"}} 2000w"
            sizes="(min-width: 1400px) 1400px, 92vw"
            src="{{img_url feature_image size="xl"}}"
            alt="{{feature_image_alt}}"
        />
        {{#if feature_image_caption}}
            <figcaption>{{feature_image_caption}}</figcaption>
        {{/if}}
    </figure>
    {{/if}}

    <!-- HEADER -->
    <header class="page-header gh-canvas">
        <h1 class="page-title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="page-subtitle">{{custom_excerpt}}</p>
        {{/if}}
    </header>

    <!-- MAIN CONTENT -->
  <section class="page-content gh-canvas">

    <div class="dynamic-content">
        {{content}}
    </div>

    {{!-- Auto File Grid --}}
    <div class="file-grid">
        {{#match content regex="\\.(pdf|docx|doc|pptx|ppt|xlsx|xls)"}}
            {{content}}
        {{/match}}
    </div>

</section>


</main>

{{/post}}
