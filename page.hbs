{{!< default}}

{{#post}}

<main id="site-main" class="page-wrapper">

    <!-- FEATURE IMAGE -->
    {{#if feature_image}}
    <figure class="page-feature-image gh-canvas">
        <img
            src="{{img_url feature_image}}"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w"
            sizes="(max-width: 768px) 100vw, 92vw"
            loading="lazy"
            decoding="async"
            alt="{{feature_image_alt}}"
        />
    </figure>
    {{/if}}

    <!-- HEADER -->
    <header class="page-header gh-canvas">
        <h1 class="page-title">{{title}}</h1>
        {{#if custom_excerpt}}
            <p class="page-subtitle">{{custom_excerpt}}</p>
        {{/if}}
    </header>

    <!-- MAIN CONTENT -->
    <section class="page-content gh-canvas">
        <div class="dynamic-content">
            {{content}}
        </div>
    </section>

</main>

{{/post}}

<!-- Load PDF.js from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
